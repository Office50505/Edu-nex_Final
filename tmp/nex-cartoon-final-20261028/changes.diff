+function charactersFrom(facts) {
+  return Object.entries(facts).filter(([key]) => /^character \d+$/u.test(key)).map(([key, value]) => {
+    const match = value.match(/^(.+?)(?:,|\s+(?:the|is an?|hai)\s+)(.*)$/iu);
