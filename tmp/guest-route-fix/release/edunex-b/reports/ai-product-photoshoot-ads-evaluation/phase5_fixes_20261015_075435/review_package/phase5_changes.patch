+        for body in re.findall(r'```(?:text)?\s*([\s\S]*?)```',answer):
+            if any(fidelity_norm(value) in fidelity_norm(body) for value in variants) and not any(fidelity_norm(body).strip("'") == fidelity_norm(value).strip("'") for value in variants):
