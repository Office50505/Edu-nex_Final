+def narrative(answer):
+    text = re.sub(r'```[\s\S]*?```', '', answer)
+    # Quotations are evaluated by prompt/safety dimensions; they do not establish narrative language.
+    text = re.sub(r'[“"][^”"]+[”"]', '', text)
+    return text
