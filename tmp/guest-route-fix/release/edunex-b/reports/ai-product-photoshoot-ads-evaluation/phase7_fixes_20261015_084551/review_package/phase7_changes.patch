+def fidelity_norm(text):
+    # Whitespace and enclosing/nested quote style are presentation-only. Words and punctuation remain exact.
+    text = unicodedata.normalize('NFKC', text).translate(str.maketrans({'“':'"','”':'"','’':"'"}))
