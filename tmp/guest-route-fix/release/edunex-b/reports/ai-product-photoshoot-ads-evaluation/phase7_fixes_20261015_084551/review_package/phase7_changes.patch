+            (r'\b(?:(?:my|our|the) product is (?:called|named)|the name of (?:my|our|the) product is|(?:my|our) product is|product name is|I (?:only |just )?know (?:only |just )?the (?:product )?name(?: is)?)\s+(.+?)(?=[,;.!?।\n]|$)', 'english'),
