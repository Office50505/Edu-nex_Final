+        # the entire negated noun phrase; unrelated No elsewhere does not suffice.
+        if not present and re.match(r'^\s*No(?:[,.!]|$|\s+(?:this|it)\b)',re.sub(r'^\s*(?:\*\*)?(?:Lesson|L)\s*0?\d+(?:\*\*)?\s*\n+', '',answer,flags=re.I),re.I):
+            for term in group:
