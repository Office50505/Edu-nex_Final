+            m=re.search(pattern,message,re.I)
+            if not m:continue
+            candidate=re.split(r'\s+(?:on|through|via|at|with|using|priced)\b|\s+for\s+(?:\d|₹|\$)',m[1],maxsplit=1,flags=re.I)[0].strip()
