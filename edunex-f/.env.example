# Skillomate frontend environment
# Public values only. Do not put backend secrets here.

# Leave blank for local development so /api requests use the Vite proxy.
# Production: https://api.skillomate.in (do not include a trailing /api).
VITE_API_BASE_URL=

# Vite dev/preview API proxy target.
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Optional visitor analytics. Public browser IDs only.
# Google Analytics 4: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
# Microsoft Clarity project id for click heatmaps and session recordings.
VITE_CLARITY_PROJECT_ID=
