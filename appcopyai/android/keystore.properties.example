# Copy to keystore.properties (which is ignored) or provide these values as
# environment/Gradle properties. Keep the keystore itself outside Git.
SKILLOMATE_RELEASE_STORE_FILE=../skillomate-upload.jks
SKILLOMATE_RELEASE_STORE_PASSWORD=replace-with-secret
SKILLOMATE_RELEASE_KEY_ALIAS=skillomate-upload
SKILLOMATE_RELEASE_KEY_PASSWORD=replace-with-secret
