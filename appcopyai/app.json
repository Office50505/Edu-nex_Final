{
  "expo": {
    "name": "Skillomate",
    "slug": "skillomate",
    "version": "1.0",
    "description": "Skillomate learning app",
    "scheme": "skillomate",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "package": "com.skillomate.app",
      "versionCode": 10,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ],
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F1"
      },
      "softwareKeyboardLayoutMode": "pan",
      "userInterfaceStyle": "automatic"
    },
    "ios": {
      "bundleIdentifier": "com.alihussainkhan.edunexfinal",
      "buildNumber": "21",
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Skillomate",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow Skillomate to choose a profile photo from your photo library.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "owner": "office50505",
    "plugins": [
      "expo-sharing",
      "expo-font",
      "expo-video",
      "expo-secure-store",
      "react-native-iap"
    ],
    "extra": {
      "eas": {
        "projectId": "33362fff-8f6f-4fe9-a7ac-bc11f9b34555"
      }
    }
  }
}
