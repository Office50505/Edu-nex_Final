{
  "expo": {
    "name": "EduNex",
    "slug": "edunex",
    "version": "1.0.0",
    "description": "EduNex learning app",
    "jsEngine": "jsc",
    "scheme": "com.alihussainkhan.edunexfinal",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "package": "com.example.protectedvideo",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F1"
      },
      "softwareKeyboardLayoutMode": "pan",
      "userInterfaceStyle": "automatic"
    },
    "ios": {
      "bundleIdentifier": "com.alihussainkhan.edunexfinal",
      "buildNumber": "7",
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "EduNex",
