{
  "expo": {
    "name": "Skillomate",
    "slug": "skillomate",
    "version": "1.0",
    "description": "Skillomate learning app",
    "scheme": "com.skillomate.app",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "package": "com.skillomate.app",
      "versionCode": 3,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA"
      ],
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F1"
      },
      "softwareKeyboardLayoutMode": "pan",
      "userInterfaceStyle": "automatic"
    },
    "ios": {
      "bundleIdentifier": "com.alihussainkhan.edunexfinal",
      "buildNumber": "12",
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Skillomate",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Skillomate lets you choose a profile picture from your photo library.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "13.203.94.35": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "owner": "office50505",
    "plugins": [
      "expo-sharing",
      "expo-font",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "33362fff-8f6f-4fe9-a7ac-bc11f9b34555"
      }
    }
  }
}
