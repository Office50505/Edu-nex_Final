 const appSource = fs.readFileSync(path.join(mobileRoot, 'App.js'), 'utf8');
+const vm = require('node:vm');
+const babel = require(path.join(mobileRoot, 'node_modules/@babel/core'));
+const appAst = babel.parseSync(appSource, { configFile: false, babelrc: false, parserOpts: { plugins: ['jsx'] } });
+const appNodeSource = node => appSource.slice(node.start, node.end);
+function findAppNode(node, predicate) {
+  if (!node || typeof node !== 'object') return null;
+  if (predicate(node)) return node;
+  for (const value of Object.values(node)) for (const child of Array.isArray(value) ? value : [value]) {
+    const found = findAppNode(child, predicate); if (found) return found;
+  }
+  return null;
+}
+function courseRenderRoute() {
+  const node = findAppNode(appAst, node => node.type === 'IfStatement'
+    && appNodeSource(node.test).includes('selectedCourse')
+    && appNodeSource(node.test).includes('mainScreen')
+    && appNodeSource(node.consequent).includes('<ReelsScreen')
+    && appNodeSource(node.consequent).includes('<VideoListScreen'));
+  assert.ok(node, 'actual course/player render route is present');
+  return appNodeSource(node.consequent);
+}
+function tabletStyle(name) {
+  const node = findAppNode(appAst, node => node.type === 'ObjectProperty' && node.key?.name === name);
+  assert.ok(node, `tablet style ${name} is defined`);
+  return vm.runInNewContext(`(${appNodeSource(node.value)})`);
+}
