NODE_ENV=development
PORT=3000
SERVE_FRONTEND=false
FRONTEND_DIR=../edunex-f
FRONTEND_DIST_DIR=../edunex-f/dist

# Frontend CORS
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/edunex

# Auth secrets. Use long random values in staging/production.
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_SIGNUP_SECRET=change-me-signup-secret
ADMIN_TOKEN_SECRET=change-me-admin-secret
ADMIN_PASSWORD=change-me-admin-password
MAX_COMPAT_ACTIVE_SESSIONS=3
DISABLE_AUTH_RATE_LIMIT=false

# OTP
OTP_PROVIDER=demo
AUTO_VERIFY_OTP=false
DEV_OTP=123456
DEFAULT_SMS_COUNTRY_CODE=+91

# Payments
PAYMENT_GATEWAY_MODE=simulated
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=
PHONEPE_CALLBACK_URL=
PHONEPE_REDIRECT_URL=

# Bunny video/CDN
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_REGION=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_PULL_ZONE_URL=
BUNNY_CDN_HOST=

# Optional Firebase Cloud Messaging HTTP v1 credentials for mobile silent logout push.
# Prefer FCM_SERVICE_ACCOUNT_JSON in production secret storage, or set the direct fields.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Support/contact email delivery.
SUPPORT_EMAIL_TO=support@skillomate.in
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@skillomate.in
SMTP_PASS=
SMTP_FROM="Skillomate Support <support@skillomate.in>"

# Optional comma-separated allowlist for /api/image-proxy.
# Leave blank to allow public internet image hosts while still blocking private/internal networks.
IMAGE_PROXY_ALLOWED_HOSTS=

# AI
FAL_API_KEY=
FAL_KEY=
FAL_OPENROUTER_MODEL=google/gemini-2.5-flash
FAL_OPENROUTER_URL=https://fal.run/openrouter/router/openai/v1/chat/completions
AI_SERVER_URL=

# Cache / jobs
REDIS_URL=
ANALYTICS_TIMEZONE=Asia/Kolkata
DISABLE_BACKGROUND_JOBS=false

# Smoke test runner
SMOKE_ENV_PATH=
SMOKE_API_BASE_URL=http://127.0.0.1:3000
SMOKE_PORT=3100
SMOKE_REQUIRE_DB=true
SMOKE_TIMEOUT_MS=10000
SMOKE_ENABLE_BACKGROUND_JOBS=false
SMOKE_LOGIN_ID=
SMOKE_PASSWORD=
SMOKE_USER_ID=
SMOKE_SESSION_ID=
SMOKE_COURSE_ID=
SMOKE_LESSON_ID=
SMOKE_VIDEO_ID=
SMOKE_ADMIN_PASSWORD=
SMOKE_BUNNY_GUID=
