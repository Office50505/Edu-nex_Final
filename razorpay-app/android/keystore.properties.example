# Copy to keystore.properties (which is ignored) or provide these values as
# environment/Gradle properties. Keep the keystore itself outside Git.
SKILLOMATE_DIRECT_RELEASE_STORE_FILE=../skillomate-direct-upload.jks
SKILLOMATE_DIRECT_RELEASE_STORE_PASSWORD=replace-with-secret
SKILLOMATE_DIRECT_RELEASE_KEY_ALIAS=skillomate-direct-upload
SKILLOMATE_DIRECT_RELEASE_KEY_PASSWORD=replace-with-secret
