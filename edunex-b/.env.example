NODE_ENV=development
PORT=3000
SERVE_FRONTEND=false
FRONTEND_DIR=../edunex-f
FRONTEND_DIST_DIR=../edunex-f/dist

# Frontend CORS
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/edunex
# MongoDB driver pool and connection timeouts (positive integers).
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000

# Auth secrets. Use long random values in staging/production.
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_SIGNUP_SECRET=change-me-signup-secret
ADMIN_TOKEN_SECRET=change-me-admin-secret
ADMIN_PASSWORD=change-me-admin-password
MAX_COMPAT_ACTIVE_SESSIONS=3
# One-line toggle: true = rate limiting on, false = rate limiting off.
RATE_LIMITING_ENABLED=true
# Legacy testing toggle: disables auth, admin login, deletion request, and assessment submit rate limits.
DISABLE_RATE_LIMITS=false
# Extra confirmation required only if NODE_ENV=production and rate limits are disabled.
ALLOW_RATE_LIMIT_DISABLE_IN_PRODUCTION=false
# Legacy auth-only toggle; prefer DISABLE_RATE_LIMITS for full testing bypass.
DISABLE_AUTH_RATE_LIMIT=false

# OTP
OTP_PROVIDER=msg91
AUTO_VERIFY_OTP=false
DEV_OTP=123456
DEFAULT_SMS_COUNTRY_CODE=+91

# Payments
PAYMENT_GATEWAY_MODE=razorpay
# Permanent production kill switch. PhonePe initiation, callbacks, and webhooks are disabled unless explicitly true.
PHONEPE_ENABLED=false
# New PhonePe checkout additionally requires this flag and PAYMENT_GATEWAY_MODE=phonepe.
PHONEPE_NEW_PAYMENTS_ENABLED=false
# Dedicated ad/onboarding offer mode. Use test locally and live in production.
AD_PAYMENT_MODE=test
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=
PHONEPE_CALLBACK_URL=
PHONEPE_REDIRECT_URL=

# Bunny video/CDN
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_REGION=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_PULL_ZONE_URL=
BUNNY_CDN_HOST=

# Optional Firebase Cloud Messaging HTTP v1 credentials for mobile silent logout push.
# Prefer FCM_SERVICE_ACCOUNT_JSON in production secret storage, or set the direct fields.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Support/contact email delivery.
SUPPORT_EMAIL_TO=support@skillomate.in
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@skillomate.in
SMTP_PASS=
SMTP_FROM="Skillomate Support <support@skillomate.in>"

# Optional comma-separated allowlist for /api/image-proxy.
# Leave blank to allow public internet image hosts while still blocking private/internal networks.
IMAGE_PROXY_ALLOWED_HOSTS=

# AI
FAL_API_KEY=
FAL_KEY=
FAL_OPENROUTER_MODEL=google/gemini-2.5-flash
FAL_OPENROUTER_URL=https://fal.run/openrouter/router/openai/v1/chat/completions
AI_SERVER_URL=

# Cache / jobs
REDIS_URL=
ANALYTICS_TIMEZONE=Asia/Kolkata
DISABLE_BACKGROUND_JOBS=false

# Smoke test runner
SMOKE_ENV_PATH=
SMOKE_API_BASE_URL=http://127.0.0.1:3000
SMOKE_PORT=3100
SMOKE_REQUIRE_DB=true
SMOKE_TIMEOUT_MS=10000
SMOKE_ENABLE_BACKGROUND_JOBS=false
SMOKE_LOGIN_ID=
SMOKE_PASSWORD=
SMOKE_USER_ID=
SMOKE_SESSION_ID=
SMOKE_COURSE_ID=
SMOKE_LESSON_ID=
SMOKE_VIDEO_ID=
SMOKE_ADMIN_PASSWORD=
SMOKE_BUNNY_GUID=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=6aad0fdca0b55cc6b0003083
# Sender and DLT ID are mapped on the MSG91 OTP template, not sent as v5 OTP parameters.
MSG91_DLT_TEMPLATE_ID=1777178964721923789
MSG91_SENDER_ID=SKLMTE
MSG91_BASE_URL=https://control.msg91.com/api/v5
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
TRIAL_AMOUNT_PAISE=100
SUBSCRIPTION_AMOUNT_PAISE=49900
TRIAL_DURATION_HOURS=24
SUBSCRIPTION_TOTAL_COUNT=120
ANNUAL_SUBSCRIPTION_AMOUNT_PAISE=499900
ANNUAL_SUBSCRIPTION_TOTAL_COUNT=10

# CloudFront HLS: private by default; signing credentials stay server-side.
CLOUDFRONT_DISTRIBUTION_HOST=d2vntxz4x493rp.cloudfront.net
CLOUDFRONT_ACCESS_MODE=private
CLOUDFRONT_PUBLIC_KEY_ID=
# RSA PEM; literal \n escapes are supported. Never commit the real key.
CLOUDFRONT_PRIVATE_KEY=

# Production course thumbnails: shared S3 storage using the server IAM role/default AWS credential chain.
THUMBNAIL_S3_BUCKET=
# Required unless AWS_REGION is already configured for the process.
THUMBNAIL_S3_REGION=
# Optional shared HTTPS CDN base. Strongly recommended for private S3 buckets using CloudFront/OAC.
# Without it, the stored URL is the regional S3 object URL; bucket access must make that URL usable.
THUMBNAIL_CDN_BASE_URL=

# Admin Settings selects the mode for NEW Razorpay checkouts (stored in MongoDB).
# Generic RAZORPAY_* credentials remain the legacy mode fallback. Do not overwrite
# them with a different account/mode while legacy subscriptions still exist.
# Pin the mode of pre-existing untagged billing records before changing generic keys.
# RAZORPAY_LEGACY_MODE=test
# Optional initial mode before an admin selection exists:
# RAZORPAY_MODE=test
# Each mode requires its own plan and a DISTINCT webhook secret.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_TEST_PLAN_ID=
# Create a separate yearly plan in Test mode; never reuse the Live plan here.
RAZORPAY_TEST_ANNUAL_PLAN_ID=
RAZORPAY_TEST_WEBHOOK_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_LIVE_PLAN_ID=
RAZORPAY_LIVE_ANNUAL_PLAN_ID=plan_TdSoXLQTCRrb7P
RAZORPAY_LIVE_WEBHOOK_SECRET=
